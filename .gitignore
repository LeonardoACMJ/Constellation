__pycache__/
*.py[cod]
/.venv/
/venv/

# Logs, temporary files and backups
*.log
*.tmp
*.bak
*~

# OS and machine-specific editor state (shared editor settings stay trackable)
.DS_Store
Thumbs.db
desktop.ini
/.vs/
/.idea/workspace.xml
/.vscode/*.local.*
